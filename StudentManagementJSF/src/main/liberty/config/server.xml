<?xml version="1.0" encoding="UTF-8"?>
<server description="Student Management JSF Application">

    <featureManager>
        <feature>servlet-3.1</feature>
        <feature>jsp-2.3</feature>
        <feature>el-3.0</feature>
    </featureManager>

    <httpEndpoint
        id="defaultHttpEndpoint"
        host="*"
        httpPort="9080"
        httpsPort="9443"/>

    <webApplication
        location="StudentManagementJSF.war"
        contextRoot="/StudentManagementJSF" />

</server>
